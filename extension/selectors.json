    "claude.ai": {
      "name": "Claude",
      "contextWindow": 200000,
      "user": [
        "[data-testid=\"user-message\"]",
        "[data-testid=\"human-turn\"]"
      ],
      "assistant": [
        "[data-testid=\"assistant-message\"]",
        ".font-claude-response",
        ".font-claude-message",
        "[data-testid=\"ai-turn\"]"
      ],
      "composer": [
        "div[contenteditable=\"true\"].ProseMirror",
        "div[contenteditable=\"true\"]"
      ]
    },
    "chatgpt.com": {
      "name": "ChatGPT",
      "contextWindow": 128000,
      "user": [
