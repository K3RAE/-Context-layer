# Copy this file to backend/.env and edit as needed.

# Where the API listens. Keep 127.0.0.1 unless you know you need LAN access
# (the API has no authentication).
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# Set to true for auto-reload while developing
BACKEND_RELOAD=false

# ---------------------------------------------------------------------------
# Local LLM for smarter handoff notes (all optional - without one, ContextLayer
# uses rule-based fallbacks).
#   auto   = OpenAI-compatible server if OPENAI_BASE_URL is set and reachable,
#            else Ollama if running, else rule-based
#   ollama | openai | none  = force one
LLM_PROVIDER=auto
# Long chats are trimmed to this many tokens before being sent to the model
LLM_MAX_PROMPT_TOKENS=6000
LLM_TIMEOUT=120

# Any OpenAI-compatible server (LM Studio, llama.cpp, Jan, LocalAI, vLLM ...).
# Leave blank to disable. Examples:
#   LM Studio:        http://localhost:1234/v1
#   llama.cpp server: http://localhost:8080/v1
#   Jan:              http://localhost:1337/v1
# A non-local URL sends your conversations to that server.
OPENAI_BASE_URL=
# Only needed if your server requires one. Never commit a real key.
OPENAI_API_KEY=
# Model id to use (blank = first model the server lists)
OPENAI_MODEL=

# Ollama server
OLLAMA_URL=http://127.0.0.1:11434
# Force a specific installed model, e.g. llama3.2:3b (blank = auto-pick)
OLLAMA_MODEL=

# SQLite memory database. "~" works on Windows, macOS and Linux.
MEMORY_DB_PATH=~/.contextlayer/memory.db

# LLMLingua-2 (only used if requirements-ml.txt is installed)
LLMLINGUA_ENABLED=true
LLMLINGUA_MODEL=microsoft/llmlingua-2-bert-base-multilingual-cased-meetingbank

LOG_LEVEL=INFO
