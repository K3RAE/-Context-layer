# Copy this file to backend/.env and edit as needed.

# Where the API listens. Keep 127.0.0.1 unless you know you need LAN access
# (the API has no authentication).
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# Set to true for auto-reload while developing
BACKEND_RELOAD=false

# Local Ollama server (optional — rule-based fallbacks are used without it)
OLLAMA_URL=http://localhost:11434
# Force a specific installed model, e.g. llama3.2:3b (blank = auto-pick)
OLLAMA_MODEL=
OLLAMA_TIMEOUT=120

# SQLite memory database. "~" works on Windows, macOS and Linux.
MEMORY_DB_PATH=~/.contextlayer/memory.db

# LLMLingua-2 (only used if requirements-ml.txt is installed)
LLMLINGUA_ENABLED=true
LLMLINGUA_MODEL=microsoft/llmlingua-2-bert-base-multilingual-cased-meetingbank

LOG_LEVEL=INFO
